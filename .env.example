# 이 파일을 복사해 .env 로 이름을 바꾼 뒤 값을 채우세요.
#   copy .env.example .env      (Windows)
# .env 는 절대 공유하거나 zip 에 넣어 배포하지 마세요. (.gitignore 에 포함되어 있습니다)

# --- 필수 ---------------------------------------------------------------
# Firebase 서비스 계정.
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
# 받은 JSON 파일에서 아래 3개 값만 꺼내 넣으면 됩니다.
# PRIVATE_KEY 는 줄바꿈이 역슬래시+n 으로 들어가므로 큰따옴표로 감싸세요.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# 세션 암호화 키. 아래 명령으로 만들어 붙여넣으세요.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HLTI_SECRET_KEY=

# 관리자 비밀번호 — 실제 값을 여기 적지 마세요. .env 에만 적습니다.
HLTI_ADMIN_PASSWORD=

# 평문 대신 해시를 두는 쪽이 더 안전합니다. 아래 명령으로 해시를 만든 뒤
# HLTI_ADMIN_PASSWORD 줄은 지우고 이 값만 남기세요.
#   node -e "console.log(require('./lib/security').hashPassword('여기에비밀번호'))"
# HLTI_ADMIN_PASSWORD_HASH=

# --- 선택 ---------------------------------------------------------------
# HTTPS 로 서비스할 때 1 로 바꾸세요.
HLTI_SECURE_COOKIE=0

# 리버스 프록시(nginx 등) 뒤에서 운영할 때 1
HLTI_TRUST_PROXY=0

# 세션 유효 시간(분)
HLTI_PARTICIPANT_TIMEOUT_MIN=90
HLTI_ADMIN_TIMEOUT_MIN=30

# 로그인 시도 제한
HLTI_LOGIN_MAX_ATTEMPTS=8
HLTI_LOGIN_WINDOW_SEC=300
HLTI_ADMIN_MAX_ATTEMPTS=5
HLTI_ADMIN_WINDOW_SEC=600

# 서버 주소/포트
HLTI_HOST=0.0.0.0
HLTI_PORT=3000

# 개발 중에만 1. 운영에서는 반드시 0.
HLTI_DEBUG=0
